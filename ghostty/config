# Ghostty Configuration
# Catppuccin Latte (Light Theme)

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# Window
window-padding-x = 10
window-padding-y = 10
window-decoration = true
macos-titlebar-style = hidden

# Cursor
cursor-style = block
cursor-style-blink = false

# Shell
shell-integration = zsh

# Catppuccin Latte Colors
background = eff1f5
foreground = 4c4f69

# Black
palette = 0=#5c5f77
palette = 8=#6c6f85

# Red
palette = 1=#d20f39
palette = 9=#d20f39

# Green
palette = 2=#40a02b
palette = 10=#40a02b

# Yellow
palette = 3=#df8e1d
palette = 11=#df8e1d

# Blue
palette = 4=#1e66f5
palette = 12=#1e66f5

# Magenta
palette = 5=#ea76cb
palette = 13=#ea76cb

# Cyan
palette = 6=#179299
palette = 14=#179299

# White
palette = 7=#acb0be
palette = 15=#bcc0cc

# Selection
selection-background = ccd0da
selection-foreground = 4c4f69

# Keybinds
keybind = shift+enter=text:\n
